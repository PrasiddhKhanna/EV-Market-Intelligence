# Copy this file to .env and fill in your values.
# .env is excluded from Git — never commit real credentials.

# Tableau Public embed URLs (use ?:showVizHome=no&:embed=true for clean iframe embed)
TABLEAU_DASHBOARD_URL=https://public.tableau.com/shared/Q27K39PSC?:showVizHome=no&:embed=true&:toolbar=yes&:display_count=n
TABLEAU_STORY_URL=https://public.tableau.com/views/EV_Market_Intelligence/Story1?:showVizHome=no&:embed=true&:toolbar=yes&:display_count=n&:language=en-US

# Flask settings
FLASK_ENV=production
FLASK_DEBUG=false

