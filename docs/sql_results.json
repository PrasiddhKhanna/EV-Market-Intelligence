{
  "Q1. Basic dataset / headline KPIs": {
    "query": "SELECT COUNT(*) AS vehicle_records,\n       COUNT(DISTINCT vehicle_id) AS unique_vehicles,\n       ROUND(SUM(annual_sales_units), 0) AS total_recorded_sales_units,\n       ROUND(AVG(range_km), 1) AS avg_range_km,\n       ROUND(AVG(price_usd), 0) AS avg_price_usd,\n       ROUND(AVG(customer_rating), 2) AS avg_customer_rating\nFROM ev_market_clean",
    "row_count": 1,
    "columns": [
      "vehicle_records",
      "unique_vehicles",
      "total_recorded_sales_units",
      "avg_range_km",
      "avg_price_usd",
      "avg_customer_rating"
    ],
    "data": [
